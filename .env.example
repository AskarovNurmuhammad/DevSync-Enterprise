# DevSync Enterprise Environment Configuration Example

# PostgreSQL Database
POSTGRES_USER=devsync_admin
POSTGRES_PASSWORD=devsync_secret
POSTGRES_DB=devsync_db
DATABASE_URL="postgresql://devsync_admin:devsync_secret@localhost:5432/devsync_db?schema=public"

# Redis Cache & Sessions
REDIS_HOST=localhost
REDIS_PORT=6379

# Backend Configuration
PORT=4000
JWT_SECRET=super_secret_jwt_key_devsync_enterprise_2026_change_me
JWT_REFRESH_SECRET=super_secret_refresh_key_devsync_enterprise_2026_change_me
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CLIENT_URL=http://localhost:3000

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
